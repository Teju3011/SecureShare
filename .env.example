# SECURESHARE Environment Configuration Template

# Server Configuration
PROJECT_NAME="SECURESHARE"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="secureshare-super-secret-jwt-signing-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES-256-GCM Storage Encryption Key (32 bytes / 64 hex characters)
# Generate with: openssl rand -hex 32 or python -c "import secrets; print(secrets.token_hex(32))"
FILE_ENCRYPTION_KEY_HEX="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Database Configuration
# In Docker: postgresql://secureshare:secureshare_pass@postgres:5432/secureshare_db
# In Local Dev: sqlite:///./secureshare.db or local postgres
DATABASE_URL="sqlite:///./secureshare.db"

# Storage Provider Configuration
# Options: "local" or "minio"
STORAGE_PROVIDER="local"
STORAGE_LOCAL_ROOT="./storage_data"

# MinIO / S3 Configuration (used if STORAGE_PROVIDER=minio)
MINIO_ENDPOINT="minio:9000"
MINIO_ACCESS_KEY="secureshare_minio_user"
MINIO_SECRET_KEY="secureshare_minio_secret_password"
MINIO_CLEAN_BUCKET="secureshare-clean"
MINIO_QUARANTINE_BUCKET="secureshare-quarantine"
MINIO_SECURE=False

# Malware Scanning & ClamAV Configuration
# Mode: "live" (requires ClamAV daemon) or "smart" (checks daemon, executes high-assurance signature & EICAR checks, fails closed if unreachable in live mode)
CLAMAV_HOST="clamav"
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=15
CLAMAV_MODE="smart"

# Rate Limiting
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_SHARE_ACCESS="20/minute"
RATE_LIMIT_UPLOAD="30/minute"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
